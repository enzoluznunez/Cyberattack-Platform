# Copy this file to .env (same folder) if you need to change a setting. Git
# ignores .env, so what you put there stays on this machine. Sign in first with
# `gcloud auth application-default login`; there is no password to put here.

# The Google Cloud project holding the dataset. Leave it out to use your gcloud
# default project.
GOOGLE_CLOUD_PROJECT=cyberattack-platform

# The BigQuery dataset the API reads. Leave it unless you want a scratch copy.
BIGQUERY_DATASET=cyber

# Where rebuild.py reads the two exports from: the bucket, or a local folder
# holding breach_events.csv and company_fundamentals.csv.
RAW_SOURCE=gs://cyberattack-platform-raw
